# Copy this file to .env (DO NOT commit .env)
# Get keys at the URLs in the comments

# Gemini API (S1, S2, S3, S4)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Telegram Bot (S2 option A)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LINE Messaging API (S2 option B)
# https://developers.line.biz/console/
LINE_CHANNEL_TOKEN=your_line_channel_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Google Sheets API (S2)
# Paste the full service account JSON here as a single line
GOOGLE_SHEETS_CREDENTIALS=your_google_sheets_service_account_json_here
# Spreadsheet URL or ID of the target Google Sheet
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1pcz6nIFn9CmCKelejn4CqAi3p-EJdFI1LWSDYM6sLDc/edit?usp=sharing

# HuggingFace (S3 deploy)
# https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
